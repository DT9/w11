# w11.git worktree is C:\. Deny the OS disk unless a reviewed path is allowlisted.
/*
!/.gitignore
!/.gitattributes
!/.githooks/
!/.githooks/**
!/.profile-git/
!/.profile-git/**

!/Users/
/Users/*
!/Users/deploy/
/Users/deploy/*

!/Users/deploy/.config/
!/Users/deploy/.config/**
!/Users/deploy/.sff/
!/Users/deploy/.sff/**

!/Users/deploy/AppData/
/Users/deploy/AppData/*
!/Users/deploy/AppData/Local/
/Users/deploy/AppData/Local/*
!/Users/deploy/AppData/Local/FanControl/
/Users/deploy/AppData/Local/FanControl/*
!/Users/deploy/AppData/Local/FanControl/Configurations/
/Users/deploy/AppData/Local/FanControl/Configurations/*
!/Users/deploy/AppData/Local/FanControl/Configurations/userConfig.json

!/Users/deploy/AppData/Roaming/
/Users/deploy/AppData/Roaming/*
!/Users/deploy/AppData/Roaming/ludusavi/
/Users/deploy/AppData/Roaming/ludusavi/*
!/Users/deploy/AppData/Roaming/ludusavi/config.yaml

!/Users/deploy/AppData/Roaming/WizTree3/
/Users/deploy/AppData/Roaming/WizTree3/*
!/Users/deploy/AppData/Roaming/WizTree3/WizTree3.ini

!/Users/deploy/AppData/Roaming/Notepad++/
/Users/deploy/AppData/Roaming/Notepad++/*
!/Users/deploy/AppData/Roaming/Notepad++/config.xml
!/Users/deploy/AppData/Roaming/Notepad++/contextMenu.xml
!/Users/deploy/AppData/Roaming/Notepad++/langs.xml
!/Users/deploy/AppData/Roaming/Notepad++/shortcuts.xml
!/Users/deploy/AppData/Roaming/Notepad++/stylers.xml
!/Users/deploy/AppData/Roaming/Notepad++/plugins/
/Users/deploy/AppData/Roaming/Notepad++/plugins/*
!/Users/deploy/AppData/Roaming/Notepad++/plugins/Config/
/Users/deploy/AppData/Roaming/Notepad++/plugins/Config/*
!/Users/deploy/AppData/Roaming/Notepad++/plugins/Config/converter.ini
!/Users/deploy/AppData/Roaming/Notepad++/plugins/config/
/Users/deploy/AppData/Roaming/Notepad++/plugins/config/*
!/Users/deploy/AppData/Roaming/Notepad++/plugins/config/converter.ini

!/Users/deploy/AppData/Roaming/Playnite/
/Users/deploy/AppData/Roaming/Playnite/*
!/Users/deploy/AppData/Roaming/Playnite/config.json
!/Users/deploy/AppData/Roaming/Playnite/fullscreenConfig.json
!/Users/deploy/AppData/Roaming/Playnite/windowPositions.json

!/Users/deploy/AppData/Roaming/Parsec/
!/Users/deploy/AppData/Roaming/Parsec/**

# Defense in depth.
**/.ssh/**
**/Cache/**
**/cache/**
**/Logs/**
**/logs/**
**/Cookies*
**/Login Data*
**/Web Data*
**/History*
**/session.xml*
**/loginusers.vdf
**/Electronic Arts/**
**/EA Desktop/**
**/*.log
**/*.log*
!/Users/deploy/AppData/Roaming/Parsec/**
**/*.dmp
**/*.tmp
**/*.db
**/*.sqlite*
**/*.pem
**/*.pfx
!/Users/deploy/.config/apollo/credentials/
!/Users/deploy/.config/apollo/credentials/*.pem
/Users/deploy/AppData/Roaming/Parsec/lock
/Users/deploy/AppData/Roaming/Parsec/lock_client

# Machine git metadata lives at C:\, not under the user profile.
/Users/deploy/.gitignore
/Users/deploy/.gitattributes
/Users/deploy/.githooks/
/Users/deploy/.profile-git/
